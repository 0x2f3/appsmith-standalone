# Copie pra .env e ajuste antes do primeiro deploy
# (no Railway, essas vars são configuradas no wizard do template)

# Secrets de criptografia — gere valores aleatórios (mín. 10 chars cada)
APPSMITH_ENCRYPTION_PASSWORD=generate-a-random-password
APPSMITH_ENCRYPTION_SALT=generate-a-random-salt

# Porta do container (o Appsmith escuta na 80)
PORT=80
